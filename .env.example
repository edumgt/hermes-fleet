# ---- Hermes LLM 엔드포인트 ----
# provider: ollama | openai  (openai = OpenAI 호환 API: vLLM, LM Studio, OpenRouter 등)
# 로컬 Ollama 예: ollama / hermes3:8b / HERMES_BASE_URL 비움
# 로컬 OpenAI 호환 예: openai / <model> / http://localhost:1234/v1
# OpenRouter 생성 LLM 예: openai / <model> / https://openrouter.ai/api/v1 (HERMES_API_KEY에 sk-or-...)
HERMES_LLM_PROVIDER=ollama
HERMES_MODEL=hermes3:8b
# 비우면 OLLAMA_HOST(host:port)를 따르고, 그것도 없으면 WSL은 Windows 호스트(기본 게이트웨이), 그 외는 localhost
HERMES_BASE_URL=
HERMES_API_KEY=NA
HERMES_TEMPERATURE=0.2

# ---- Jev (TypeSafe AI 판단 전용 모델) — Docker 모니터 재기동 때 레포별 '프로젝트로 진행할지' 판정 (review 블록) ----
# typesafe | openrouter. 비우면 URL/키(sk-or-...)로 자동 판별. 비우면 판정을 건너뛴다.
JEV_PROVIDER=
# TypeSafe 직접 API 키(https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=
# OpenRouter 키(권장: TYPESAFE_API_KEY와 분리). https://openrouter.ai/keys
OPENROUTER_API_KEY=
# TypeSafe: 기본 https://api.typesafe.ai / OpenRouter: 기본 https://openrouter.ai
TYPESAFE_BASE_URL=
# TypeSafe: jev-latest / OpenRouter: typesafe/jev-1.14 또는 ~typesafe/jev-latest
JEV_MODEL=jev-latest

# ---- 파이프라인 ----
HERMES_MAX_ITERATIONS=2
HERMES_SHELL_TIMEOUT=900

# ---- fleet 설정 파일 (기본: fleet.yaml) ----
HERMES_FLEET_CONFIG=

# ---- CrewAI 텔레메트리 비활성화 ----
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true

# ---- 시간대: 모든 날짜·시간은 한국 시간(KST). 코드가 TZ=Asia/Seoul 로 고정하므로 바꾸지 않는다 ----
# TZ=Asia/Seoul
